{
  "name": "client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "start": "bun scripts/serve-local.ts start",
    "build": "bunx --bun vite build",
    "serve": "vite preview",
    "serve:test": "bun scripts/serve-local.ts test",
    "test": "vitest run",
    "openapi-ts": "openapi-ts",
    "api:generate": "node ../scripts/api-contract.mjs",
    "api:check": "node ../scripts/api-contract.mjs --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "tsc": "tsc --noEmit && tsc -p tsconfig.vite.json",
    "test:guardrails": "node --test tools/audit-guardrails.check.mjs",
    "test:e2e": "bunx playwright test",
    "test:e2e:ci": "bun run build && CI=true bunx playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:ui": "bunx playwright test --ui",
    "knip": "knip",
    "knip:production": "knip --production",
    "media:capture": "node scripts/capture-landing-media.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "node scripts/install-husky.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stackframe/react": "2.8.78",
    "@tanstack/form-core": "1.33.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/valibot-adapter": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "valibot": "^1.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.44.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@radix-ui/react-focus-scope": "1.1.16"
  }
}
